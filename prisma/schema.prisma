// Noura — data model.
//
// Portability rule: this schema must run on SQLite (local dev) AND PostgreSQL.
// That forbids three Prisma features we would otherwise reach for:
//   * `enum`    — unsupported on SQLite. Constrained strings instead, with the
//                 allowed values enforced by Zod at every write (lib/schemas.ts).
//   * `Json`    — unsupported on SQLite. Structured blobs are String columns
//                 holding JSON, parsed through a Zod schema at the boundary.
//   * `Decimal` — behaves differently across the two. Money is stored as an Int
//                 in minor units (fils, 1/100 AED) and formatted by formatAed().
// To move to Postgres: change `provider` to "postgresql" and point DATABASE_URL
// at the server. Nothing else in this file changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A product we have evidence about. One row per identified product, deduplicated
/// on barcode when we have one and on slug when we do not.
model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  brand       String?
  /// EAN-13 / UPC. Null when identification never saw a barcode.
  barcode     String? @unique
  /// One of the eleven values of ProductCategory in lib/schemas.ts. The rules for
  /// each live in lib/health/categories/, one file per RUBRIC.md §4 section.
  category    String
  /// RUBRIC.md §4 C4.0.1. Selects the per-100 basis and bounds the alternative
  /// ranking. Null resolves to the category's default rather than to a guess.
  subcategory String?
  /// Vendor-neutral pack size as written on the pack, e.g. "500 ml", "250 g".
  sizeLabel   String?
  imageUrl    String?

  // ---- Evidence. Any field may be null; the UI renders "unknown", never a guess.
  ingredientsText String?
  /// JSON: NutritionFactsSchema — per 100 g/ml. Null when no nutrition data exists.
  nutritionJson   String?
  /// JSON: string[] of allergen labels, e.g. ["milk","nuts"].
  allergensJson   String?
  /// JSON: string[] of additive E-numbers/names found in the ingredients.
  additivesJson   String?
  /// NOVA ultra-processing group 1-4, from Open Food Facts. Null when unknown.
  novaGroup       Int?

  /// Where the evidence above came from, e.g. "Open Food Facts".
  evidenceSource     String
  /// DataSource for that evidence — "OPEN_DATA" for the open databases.
  evidenceSourceKind String   @default("OPEN_DATA")
  evidenceSourceUrl  String?
  /// Date the evidence was last confirmed against its source. Shown to the user.
  lastVerifiedAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings            ProductListing[]
  certifications      ProductCertification[]
  evidenceLookups EvidenceLookup[]
  analyses            HealthAnalysis[]
  scans               Scan[]

  @@index([category])
  @@index([category, subcategory])
  @@index([slug])
}

/// A UAE retailer. `connector` names the code path that supplies its listings:
/// "hand" for human checks, anything else for a live connector added later.
model Retailer {
  id         String @id @default(cuid())
  slug       String @unique
  name       String
  country    String @default("AE")
  websiteUrl String
  connector  String @default("hand")

  listings ProductListing[]
}

/// A product we track at a retailer, in a given pack size. This row is a WORK ITEM,
/// not a price: it says "somebody should check this". Every price, stock state and
/// date lives on ListingCheck, because every one of those facts is only true as of
/// the moment a person looked.
model ProductListing {
  id         String @id @default(cuid())
  productId  String
  retailerId String

  /// The pack size we track at this retailer, e.g. "330 ml".
  sizeLabel String
  /// Canonical product page, when the retailer has one. Checks may record their own.
  url       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer Retailer       @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  checks   ListingCheck[]

  @@unique([productId, retailerId, sizeLabel])
  @@index([productId])
}

/// One observation of a listing by a person, on a date.
///
/// This is the whole UAE shopping layer. No UAE grocery retailer publishes a
/// product API and we do not scrape, so a price is real only because somebody
/// stood in front of a shelf or opened a retailer page and wrote down what they
/// saw. A check is evidence with an author and an expiry, not a live feed.
model ListingCheck {
  id        String @id @default(cuid())
  listingId String

  /// Price in fils (1/100 AED). Integer minor units — never a float.
  ///
  /// NULLABLE, because price and availability are independent facts. Someone can
  /// walk past a shelf and record "it is there" without noting the price, and a
  /// retailer page can list a price for something it will not ship. Forcing both
  /// meant every check had to invent whichever half was missing.
  priceFils Int?
  currency  String @default("AED")
  /// The pack size actually observed, which may differ from the listing's.
  sizeLabel String
  /// Null means nobody recorded availability — which is not the same as false.
  inStock   Boolean?

  /// Optional photo of the shelf or the page. Served only by /api/listing-photo/[id].
  /// Stored the same three ways as a scan image — see Scan above and lib/storage.ts.
  /// A photo NEVER blocks a check: if storage fails, the check is saved without it.
  photoPath    String?
  photoMime    String?
  photoBlobUrl String?
  photoBytes   Bytes?

  /// Who made the check. A name or initials — enough to ask them about it later.
  /// Null for a RETAILER_PAGE or feed reading, where no person vouches for it;
  /// required for HAND_VERIFIED, enforced in lib/schemas.ts.
  checkedBy   String?
  /// When they looked. Drives the 14-day freshness rule in lib/retail/freshness.ts.
  checkedAt   DateTime
  /// The retailer page checked, when the check was done online. Null in store.
  retailerUrl String?

  /// DataSource — "HAND_VERIFIED" for a real check. Anything else, including
  /// "SYNTHETIC", can never be presented as verification. See lib/schemas.ts.
  source String
  note   String?

  createdAt DateTime @default(now())

  listing ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, checkedAt])
  @@index([checkedAt])
}

/// A conformity assessment body accredited by EIAC (eiac.gov.ae).
model AccreditedBody {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  /// What the body is accredited to certify, e.g. "Halal products, food safety".
  scope           String
  accreditationNo String
  /// DataSource. "SYNTHETIC" rows are demo scaffolding and never verify anything.
  source          String   @default("SYNTHETIC")
  sourceName      String
  sourceUrl       String
  lastVerifiedAt  DateTime

  certifications ProductCertification[]
}

/// A certificate for a product, from the MOIAT conformity register.
///
/// A row here is a certificate that was RETURNED BY THE REGISTER for this
/// product. How it was tied to the product is `matchBasis`, and that distinction
/// is the whole point: a certificate found by barcode identifies this exact
/// product, and one found by brand identifies only the brand. The second is
/// never presented as the first.
model ProductCertification {
  id                String    @id @default(cuid())
  productId         String
  /// Register identity. Not unique on its own — one certificate can cover many
  /// models — so the pair with the model number is what is unique.
  certificateNumber String
  /// "ECAS" | "EQM" | "GMark" | "Made In Emirates" | "HNM" as the register spells it.
  certificateType   String
  /// "valid" | "expired" | "suspended" — our reading of the register's status.
  status            String
  /// The register's own status word, kept verbatim so ours can be audited.
  rawStatus         String?
  issuedAt          DateTime
  expiresAt         DateTime?
  bodyId            String?

  /// How this certificate was attached to this product.
  ///   "BARCODE" — the register's model number is this product's barcode. Exact.
  ///   "BRAND"   — the brand matched and no exact product could be established.
  matchBasis String @default("BARCODE")

  /// What the register said, preserved for provenance and for auditing a match.
  registerBrand       String?
  registerModelNumber String?
  registerProductType String?
  registerCompany     String?
  registerCountry     String?

  /// DataSource. Every shipped SAMPLE- certificate is "SYNTHETIC"; only a real
  /// import (npm run seed:moiat) produces "REGULATOR_IMPORT". A SYNTHETIC row is
  /// never rendered as verification and never passes the certification check.
  source         String   @default("SYNTHETIC")
  sourceName     String
  sourceUrl      String
  lastVerifiedAt DateTime

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  body    AccreditedBody? @relation(fields: [bodyId], references: [id])

  @@unique([certificateNumber, productId, registerModelNumber])
  @@index([productId])
  @@index([matchBasis])
}

/// Proof that a NAMED SOURCE was asked a NAMED QUESTION about a product.
///
/// This is what separates "we looked and found nothing" from "we never looked",
/// and those must never render the same way. It is keyed on (product, source,
/// claim) rather than on product alone, because a product has as many
/// independent evidence records as there are sources worth asking:
///
///   Borges olive oil
///     ├── MOIAT      · UAE_CONFORMITY · NOT_FOUND
///     ├── MOIAT      · HALAL          · NOT_FOUND
///     └── (organic)  · never asked    · no row at all → UNKNOWN
///
/// Collapsing those into one `certified` boolean would destroy the only thing
/// that makes the answer honest. "No UAE conformity record found in MOIAT" and
/// "we could not check organic certification" are different facts, from
/// different registers, and the page has to be able to say both.
model EvidenceLookup {
  id        String @id @default(cuid())
  productId String

  /// Which register was asked. An EvidenceSource key — see lib/evidence/registry.ts.
  /// e.g. "MOIAT", "USDA_NOP", "EU_ORGANIC_TRACES", "MANUFACTURER_CLAIM".
  sourceKey String
  /// What it was asked ABOUT. An EvidenceClaim key: "UAE_CONFORMITY", "HALAL",
  /// "ORGANIC", "ECOLABEL". One source can answer several, separately.
  claim     String

  /// The resolved state for this (source, claim) pair. One of the six in
  /// lib/health/certification.ts. Stored so the admin coverage view can group on
  /// it without re-deriving, and recomputed on every import.
  state String

  /// The identifier that was queried, so a later correction invalidates the row.
  queriedValue String
  /// Records whose identifier IS this product's barcode. Exact.
  exactMatches Int     @default(0)
  /// Records returned for the brand that name some other product.
  brandMatches Int     @default(0)
  /// False when the query itself failed — that is UNKNOWN, not NOT_FOUND.
  succeeded    Boolean @default(true)

  /// The certificate or licence number the state rests on, when one does.
  referenceNumber String?
  validFrom       DateTime?
  validUntil      DateTime?

  sourceName String
  sourceUrl  String
  /// When this answer was retrieved. Evidence has an age.
  retrievedAt DateTime @default(now())

  /// The source's own words, verbatim, as JSON. Kept so our reading of it can be
  /// audited against what was actually returned.
  rawProvenance String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sourceKey, claim])
  @@index([productId])
  @@index([sourceKey, claim])
  @@index([state])
}

/// One run of the pipeline: an image in, a result screen out.
model Scan {
  id      String @id @default(cuid())
  /// Anonymous local user, from an httpOnly cookie. No auth in the MVP.
  userKey String

  /// Where the uploaded photo went. Exactly one of the three is set.
  ///   imageBlobUrl — Vercel Blob, when BLOB_READ_WRITE_TOKEN is configured.
  ///   imageBytes   — a compressed JPEG in the row, when it is not.
  ///   imagePath    — a file under UPLOAD_DIR, local development only.
  /// A serverless filesystem is ephemeral, so imagePath cannot be the production
  /// answer; lib/storage.ts picks. See DECISIONS.md §64.
  imagePath    String?
  imageMime    String?
  imageBlobUrl String?
  imageBytes   Bytes?

  /// "complete" | "needs_confirmation" | "failed"
  ///
  /// `needs_confirmation` is a scan that found candidates it cannot separate.
  /// NOTHING IS EVALUATED in that state — there is no HealthAnalysis row until
  /// the shopper taps one. A verdict about the wrong variant is worse than no
  /// verdict, so the analysis waits for the answer.
  status         String
  /// How the product was arrived at, and what the result page therefore claims:
  ///   BARCODE         — "matched by barcode"
  ///   NAME_AUTO       — "matched by name, confirm below"
  ///   USER_CONFIRMED  — "You confirmed this product"
  /// Null while a scan is still waiting to be confirmed, or when it failed.
  matchSource    String?
  /// JSON: the candidates offered for confirmation. Kept after the answer too,
  /// so a shopper can change their mind without re-scanning.
  candidatesJson String?
  /// "live" (Anthropic API) | "mock" (no ANTHROPIC_API_KEY)
  mode           String

  /// JSON: IdentificationSchema — what stage 2 thought the product was.
  identificationJson String
  /// Set when evidence retrieval matched a product. Null on a failed scan.
  productId          String?
  /// Populated when the pipeline could not finish.
  error              String?

  createdAt DateTime @default(now())

  product  Product?        @relation(fields: [productId], references: [id])
  analysis HealthAnalysis?

  @@index([userKey, createdAt])
}

/// The health verdict for one scan. Both the checklist and the verdict are
/// computed by lib/health/evaluate.ts, never by the model — see DECISIONS.md §4.
model HealthAnalysis {
  id        String @id @default(cuid())
  scanId    String @unique
  productId String

  /// "good_choice" | "acceptable" | "not_recommended" | "could_not_verify"
  /// — Verdict in lib/schemas.ts. There is deliberately no numeric score.
  verdict      String
  /// JSON: VerdictResult — the verdict plus the counts it was derived from.
  verdictJson  String
  /// JSON: Check[] — every rubric dimension as pass / fail / unknown, with the
  /// measured value and source behind it.
  checksJson   String
  /// JSON: string[] — what we could not determine, shown as "unknown".
  unknownsJson String
  /// JSON: NoteSchema[] — shown to the reader, never counted. RUBRIC.md §3 U5.1,
  /// §5 A4, and the per-category notes in §4.
  notesJson    String @default("[]")

  /// Model that wrote the prose, or "deterministic" in mock mode.
  model String
  mode  String

  createdAt DateTime @default(now())

  scan    Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// One row per (client, hour) for the endpoints that cost money or compute.
///
/// In the database rather than in memory because a serverless deployment runs
/// many instances and a per-process counter would multiply the real limit by the
/// number of lambdas. This is slower and correct.
///
/// `key` is a SHA-256 of the client IP with a per-deployment salt, so the table
/// holds no addresses: a rate-limit table is not a reason to start logging who
/// scanned what.
model RateLimit {
  /// "<hashed client>:<bucket name>:<hour>"
  id          String   @id
  count       Int      @default(0)
  /// Start of the hour this bucket counts. Rows older than a day are prunable.
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// A product a shopper scanned that the catalogue does not have.
///
/// The pilot's most useful output is a list of what it could not identify, so
/// this is a queue rather than a log line: /admin/missing shows what the model
/// read, how often it has been seen, and the scan image to check it against.
///
/// It stores only what the model read off the pack. No user key, because who
/// scanned it is not part of the question.
model MissingProduct {
  id          String @id @default(cuid())
  /// Lowercased "brand|name" — so the same product seen twice is one row.
  fingerprint String @unique

  name        String
  brand       String?
  sizeLabel   String?
  category    String
  subcategory String?
  /// What the model transcribed off the pack, to sanity-check its reading.
  visibleText String?
  /// The most recent scan of it, for the photo. Not a relation: a scan can be
  /// deleted (§27) and that must not delete the queue entry.
  lastScanId  String?

  timesSeen Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  @@index([lastSeen])
}
