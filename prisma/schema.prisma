// Noura — data model.
//
// Portability rule: this schema must run on SQLite (local dev) AND PostgreSQL.
// That forbids three Prisma features we would otherwise reach for:
//   * `enum`    — unsupported on SQLite. Constrained strings instead, with the
//                 allowed values enforced by Zod at every write (lib/schemas.ts).
//   * `Json`    — unsupported on SQLite. Structured blobs are String columns
//                 holding JSON, parsed through a Zod schema at the boundary.
//   * `Decimal` — behaves differently across the two. Money is stored as an Int
//                 in minor units (fils, 1/100 AED) and formatted by formatAed().
// To move to Postgres: change `provider` to "postgresql" and point DATABASE_URL
// at the server. Nothing else in this file changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A product we have evidence about. One row per identified product, deduplicated
/// on barcode when we have one and on slug when we do not.
model Product {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  brand     String?
  /// EAN-13 / UPC. Null when identification never saw a barcode.
  barcode   String? @unique
  /// One of the eleven values of ProductCategory in lib/schemas.ts. The rules for
  /// each live in lib/health/categories/, one file per RUBRIC.md §4 section.
  category  String
  /// RUBRIC.md §4 C4.0.1. Selects the per-100 basis and bounds the alternative
  /// ranking. Null resolves to the category's default rather than to a guess.
  subcategory String?
  /// Vendor-neutral pack size as written on the pack, e.g. "500 ml", "250 g".
  sizeLabel String?
  imageUrl  String?

  // ---- Evidence. Any field may be null; the UI renders "unknown", never a guess.
  ingredientsText String?
  /// JSON: NutritionFactsSchema — per 100 g/ml. Null when no nutrition data exists.
  nutritionJson   String?
  /// JSON: string[] of allergen labels, e.g. ["milk","nuts"].
  allergensJson   String?
  /// JSON: string[] of additive E-numbers/names found in the ingredients.
  additivesJson   String?
  /// NOVA ultra-processing group 1-4, from Open Food Facts. Null when unknown.
  novaGroup       Int?

  /// Where the evidence above came from, e.g. "Open Food Facts".
  evidenceSource     String
  /// DataSource for that evidence — "OPEN_DATA" for the open databases.
  evidenceSourceKind String  @default("OPEN_DATA")
  evidenceSourceUrl  String?
  /// Date the evidence was last confirmed against its source. Shown to the user.
  lastVerifiedAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings       ProductListing[]
  certifications ProductCertification[]
  analyses       HealthAnalysis[]
  scans          Scan[]

  @@index([category])
  @@index([category, subcategory])
  @@index([slug])
}

/// A UAE retailer. `connector` names the code path that supplies its listings:
/// "hand" for human checks, anything else for a live connector added later.
model Retailer {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  country    String  @default("AE")
  websiteUrl String
  connector  String  @default("hand")

  listings ProductListing[]
}

/// A product we track at a retailer, in a given pack size. This row is a WORK ITEM,
/// not a price: it says "somebody should check this". Every price, stock state and
/// date lives on ListingCheck, because every one of those facts is only true as of
/// the moment a person looked.
model ProductListing {
  id         String @id @default(cuid())
  productId  String
  retailerId String

  /// The pack size we track at this retailer, e.g. "330 ml".
  sizeLabel String
  /// Canonical product page, when the retailer has one. Checks may record their own.
  url       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer Retailer       @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  checks   ListingCheck[]

  @@unique([productId, retailerId, sizeLabel])
  @@index([productId])
}

/// One observation of a listing by a person, on a date.
///
/// This is the whole UAE shopping layer. No UAE grocery retailer publishes a
/// product API and we do not scrape, so a price is real only because somebody
/// stood in front of a shelf or opened a retailer page and wrote down what they
/// saw. A check is evidence with an author and an expiry, not a live feed.
model ListingCheck {
  id        String @id @default(cuid())
  listingId String

  /// Price in fils (1/100 AED). Integer minor units — never a float.
  priceFils Int
  currency  String  @default("AED")
  /// The pack size actually observed, which may differ from the listing's.
  sizeLabel String
  inStock   Boolean

  /// Optional photo of the shelf or the page. Served only by /api/listing-photo/[id].
  photoPath String?
  photoMime String?

  /// Who made the check. A name or initials — enough to ask them about it later.
  checkedBy String
  /// When they looked. Drives the 14-day freshness rule in lib/retail/freshness.ts.
  checkedAt DateTime
  /// The retailer page checked, when the check was done online. Null in store.
  retailerUrl String?

  /// DataSource — "HAND_VERIFIED" for a real check. Anything else, including
  /// "SYNTHETIC", can never be presented as verification. See lib/schemas.ts.
  source String
  note   String?

  createdAt DateTime @default(now())

  listing ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, checkedAt])
  @@index([checkedAt])
}

/// A conformity assessment body accredited by EIAC (eiac.gov.ae).
model AccreditedBody {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  /// What the body is accredited to certify, e.g. "Halal products, food safety".
  scope           String
  accreditationNo String
  /// DataSource. "SYNTHETIC" rows are demo scaffolding and never verify anything.
  source          String   @default("SYNTHETIC")
  sourceName      String
  sourceUrl       String
  lastVerifiedAt  DateTime

  certifications ProductCertification[]
}

/// A certificate for a product, from MOIAT Product Conformity open data.
model ProductCertification {
  id                String    @id @default(cuid())
  productId         String
  certificateNumber String    @unique
  /// "ECAS" | "EQM" | "Halal" | "Organic" | "GMP" — CertificateType in lib/schemas.ts
  certificateType   String
  /// "valid" | "expired" | "suspended"
  status            String
  issuedAt          DateTime
  expiresAt         DateTime?
  bodyId            String?

  /// DataSource. Every shipped SAMPLE- certificate is "SYNTHETIC"; only a real
  /// import (npm run seed:moiat) produces "REGULATOR_IMPORT". A SYNTHETIC row is
  /// never rendered as verification and never passes the certification check.
  source         String    @default("SYNTHETIC")
  sourceName     String
  sourceUrl      String
  lastVerifiedAt DateTime

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  body    AccreditedBody? @relation(fields: [bodyId], references: [id])

  @@index([productId])
}

/// One run of the pipeline: an image in, a result screen out.
model Scan {
  id String @id @default(cuid())
  /// Anonymous local user, from an httpOnly cookie. No auth in the MVP.
  userKey String

  /// Path of the stored upload, relative to the uploads dir.
  imagePath String?
  imageMime String?

  /// "complete" | "failed"
  status String
  /// "live" (Anthropic API) | "mock" (no ANTHROPIC_API_KEY)
  mode   String

  /// JSON: IdentificationSchema — what stage 2 thought the product was.
  identificationJson String
  /// Set when evidence retrieval matched a product. Null on a failed scan.
  productId String?
  /// Populated when the pipeline could not finish.
  error     String?

  createdAt DateTime @default(now())

  product  Product?        @relation(fields: [productId], references: [id])
  analysis HealthAnalysis?

  @@index([userKey, createdAt])
}

/// The health verdict for one scan. Both the checklist and the verdict are
/// computed by lib/health/evaluate.ts, never by the model — see DECISIONS.md §4.
model HealthAnalysis {
  id        String @id @default(cuid())
  scanId    String @unique
  productId String

  /// "good_choice" | "acceptable" | "not_recommended" | "could_not_verify"
  /// — Verdict in lib/schemas.ts. There is deliberately no numeric score.
  verdict String
  /// JSON: VerdictResult — the verdict plus the counts it was derived from.
  verdictJson String
  /// JSON: Check[] — every rubric dimension as pass / fail / unknown, with the
  /// measured value and source behind it.
  checksJson String
  /// JSON: string[] — what we could not determine, shown as "unknown".
  unknownsJson String
  /// JSON: NoteSchema[] — shown to the reader, never counted. RUBRIC.md §3 U5.1,
  /// §5 A4, and the per-category notes in §4.
  notesJson    String @default("[]")

  /// Model that wrote the prose, or "deterministic" in mock mode.
  model String
  mode  String

  createdAt DateTime @default(now())

  scan    Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}
