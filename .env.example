# ---------------------------------------------------------------------------
# Noura — environment.
#
# Copy to .env (.env is gitignored and has never been committed; `git log --all
# --full-history -- .env` returns nothing, and there is a test asserting the
# ignore rule).
#
# Every variable below is described in one line. Anything not listed here is not
# read: lib/config.ts is the only file in the app that touches process.env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------

# The database. A postgresql:// or postgres:// URL selects the Postgres provider
# and anything else selects SQLite — scripts/prisma-provider.ts writes the right
# one into prisma/schema.prisma before every Prisma command, so local dev and a
# Neon deployment need no schema edit between them.
DATABASE_URL="file:./dev.db"

# --- Model -----------------------------------------------------------------

# Anthropic API key for product identification and checklist wording. LEAVE UNSET
# to run in example mode: identification returns a fixture product and the
# wording is generated deterministically. The whole UI is usable with no key.
ANTHROPIC_API_KEY=""

# Model used for vision identification and checklist prose.
ANTHROPIC_MODEL="claude-sonnet-5"

# Which seeded product example mode returns. A slug from prisma/seed-data/catalogue.ts.
MOCK_PRODUCT_SLUG="coca-cola-330ml"

# Set to 1 to force example mode even when a key IS set — a demo deployment that
# should not spend anything on identification, or the end-to-end suite, which has
# to be deterministic and free. This beats ANTHROPIC_API_KEY.
NOURA_FORCE_MOCK="0"

# --- Admin -----------------------------------------------------------------

# Password for every /admin route. UNSET OR SHORTER THAN 8 CHARACTERS CLOSES
# /admin ENTIRELY — for everyone, including you. There is no other way in and no
# reset flow; changing this invalidates every signed-in phone immediately.
ADMIN_PASSWORD=""

# Extra guard on /admin/seed, which rewrites the catalogue. Signed-in operators
# still cannot reload seed data unless this is 1. Leave it 0 in production.
ALLOW_SEED_ENDPOINT="0"

# --- Storage ---------------------------------------------------------------

# Vercel Blob token. Set it and scan images and shelf photos go to blob storage;
# leave it empty and they are compressed to a JPEG under 300 KB and kept in the
# database row instead. Either works; blob is better if you expect volume.
BLOB_READ_WRITE_TOKEN=""

# Where images go in local development, when there is no blob token and the
# compressed copy still will not fit. Gitignored.
UPLOAD_DIR=".data/uploads"

# --- Behaviour -------------------------------------------------------------

# Set to 1 to skip every outbound network call (Open Food Facts included) and
# rely on seeded evidence alone. Used by the Playwright suite.
VERIFIED_OFFLINE="0"

# Identifications allowed per hour per client. Defaults to 30, which is far above
# a shopper's rate and far below a script's. Raise it only for a test harness.
SCAN_RATE_LIMIT_PER_HOUR="30"

# Salt for the rate-limit key hash, so the RateLimit table stores no IP address.
# Any random string. Falls back to ADMIN_PASSWORD, then to a development default.
RATE_LIMIT_SALT=""
