# ---------------------------------------------------------------------------
# Noura — environment. Copy to .env (.env is gitignored; never commit it).
# ---------------------------------------------------------------------------

# Database. SQLite for local dev; the schema is Postgres-compatible as written,
# so this can become postgresql://user:pass@host:5432/noura with no schema edit
# (also change `provider` in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Anthropic API key for product identification and checklist wording.
# LEAVE THIS UNSET to run in mock mode: identification returns a fixture product
# and the wording is generated deterministically. The whole UI is demoable with
# no key.
ANTHROPIC_API_KEY=""

# Model used for vision identification and health reasoning.
ANTHROPIC_MODEL="claude-sonnet-5"

# Which seeded product mock mode returns. Must be a slug from
# prisma/seed-data/catalogue.ts.
MOCK_PRODUCT_SLUG="coca-cola-330ml"

# Set to 1 to skip all outbound network calls (Open Food Facts included) and rely
# only on seeded evidence. Used by the Playwright tests.
VERIFIED_OFFLINE="0"

# Where uploaded scan images and check photos are written. Gitignored.
UPLOAD_DIR=".data/uploads"

# Guard for /admin/listings, the hand-verified price entry tool. Open in
# development; set to 1 to enable it elsewhere. There is no auth in the MVP, so a
# real deployment must put authentication in front of /admin.
ALLOW_ADMIN="0"

# Guard for /admin/seed. The reseed endpoint refuses to run unless NODE_ENV is
# "development" or this is set to 1.
ALLOW_SEED_ENDPOINT="0"
